[MAIN]
# Lets pylint resolve imports like "from models.orders import Orders"
init-hook="import sys; sys.path.insert(0, 'v2/api')"

[MESSAGES CONTROL]
disable=
    # Docstrings are not required in this project
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    # pytest fixtures are injected by argument name, which always triggers these
    redefined-outer-name,
    unused-argument,
    # tests add v2/api to sys.path before importing project modules
    wrong-import-position,
    # do_GET/do_POST/... are names required by BaseHTTPRequestHandler
    invalid-name,
    # existing request handlers are large
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-public-methods

[FORMAT]
max-line-length=120
